{
  "mappings": {
    "_meta": { "source_table": "public.products", "schema_version": 1 },
    "properties": {
      "id":  { "type": "long" },
      "sku": { "type": "keyword" },
      "name": {
        "type": "text",
        "analyzer": "vn_text",
        "fields": {
          "autocomplete": {
            "type": "text",
            "analyzer": "vn_autocomplete",
            "search_analyzer": "vn_text"
          },
          "raw": { "type": "keyword", "ignore_above": 256 }
        }
      },
      "description": { "type": "text", "analyzer": "vn_text" },
      "category":    { "type": "keyword", "normalizer": "vn_keyword" },
      "brand":       { "type": "keyword", "normalizer": "vn_keyword" },
      "price":       { "type": "scaled_float", "scaling_factor": 100 },
      "stock":       { "type": "integer" },
      "tags":        { "type": "keyword", "normalizer": "vn_keyword" },
      "is_active":   { "type": "boolean" },
      "created_at":  { "type": "date" },
      "updated_at":  { "type": "date" }
    }
  }
}

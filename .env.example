# Copy to .env and fill local-only values. Do not commit .env.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=cdc_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cdc
POSTGRES_PORT=5432
POSTGRES_BASELINE_PORT=5433
# Least-privilege replication role used only by Debezium.
DEBEZIUM_DB_USER=debezium
DEBEZIUM_DB_PASSWORD=change-me-too

# --- Kafka / Connect ---------------------------------------------------------
# Any base64 UUID; generate a new one with:
#   docker run --rm apache/kafka:3.8.0 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw
KAFKA_EXTERNAL_PORT=9092
KAFKA_CONNECT_PORT=8083
CDC_PARTITIONS=6
# Set after downloading the JMX exporter jar (connect/jmx-exporter/README.md):
# CONNECT_KAFKA_OPTS=-javaagent:/kafka/jmx-exporter/jmx_prometheus_javaagent.jar=9404:/kafka/jmx-exporter/config.yml
CONNECT_KAFKA_OPTS=
CONNECT_JMX_EXPORTER_PORT=9404

# --- Elasticsearch / UIs -----------------------------------------------------
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
KAFKA_UI_PORT=8080

# --- Consumer ----------------------------------------------------------------
CONSUMER_GROUP_ID=cdc-es-sink
CONSUMER_BATCH_SIZE=500
CONSUMER_FLUSH_INTERVAL_MS=500
# soft = keep a tombstone document with is_deleted=true (replay-safe, ADR-0003)
# hard = delete the document (subject to index.gc_deletes window)
CONSUMER_DELETE_MODE=soft
CONSUMER_LOG_LEVEL=INFO
CONSUMER_METRICS_PORTS=8000-8005

# --- Monitoring --------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
